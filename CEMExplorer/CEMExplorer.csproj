<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CEMExplorer</AssemblyName>
    <RootNamespace>CEMExplorer</RootNamespace>
    <StartupObject>CEMExplorer.Program</StartupObject>
    <Authors>Mike Cyples</Authors>
    <Company>Information &amp; Imagination</Company>
    <Product>CEM Explorer</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Update="CEMEXPLORERSKELETON.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
